{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"python3\" \".claude/hooks/read_learnings.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python3 .llm/prompt-cache/collect-usage.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
