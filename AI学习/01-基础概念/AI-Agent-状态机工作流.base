filters:
  and:
    - file.folder == "AI学习"
    - file.ext == "md"
    - anyof:
        - contains(file.name, "Agent")
        - contains(file.name, "状态机")
        - contains(file.name, "LangGraph")
        - contains(file.name, "Harness")
        - contains(file.name, "MCP")
        - contains(file.name, "Skill")
        - contains(file.name, "SubAgent")
        - contains(file.name, "Prompt")
        - contains(file.name, "RAG")

properties:
  title:
    displayName: "标题"
  type:
    displayName: "类型"
  tags:
    displayName: "标签"
  created:
    displayName: "创建日期"
  status:
    displayName: "状态"
  difficulty:
    displayName: "难度"
  sources_count:
    displayName: "来源数"

views:
  - type: table
    name: "AI Agent 主题笔记"
    limit: 50
    order:
      - file.name
      - title
      - type
      - tags
      - created
      - status
    summaries:
      file.name: Count

  - type: list
    name: "按类型分组"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - tags
      - created

  - type: table
    name: "按标签浏览"
    limit: 30
    order:
      - file.name
      - type
      - difficulty
      - created
    groupBy:
      property: tags
      direction: ASC

  - type: cards
    name: "卡片视图"
    order:
      - file.name
      - type
      - tags
