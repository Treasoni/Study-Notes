# Optional settings reference. This file is not loaded automatically.
# Copy only the values required by your local .env; never commit real credentials.

# Workspace conventions
OUTPUT_PATH=./workspace/output
TEMP_PATH=./workspace/tmp
NOTES_OUTPUT_PATH=./workspace/output
CHAPTERS_PATH=./workspace/chapters
WORKFLOW_RUNS_PATH=./workspace/workflow-runs

# Optional Obsidian publishing
OBSIDIAN_VAULT_PATH=
OBSIDIAN_NOTES_DIR=
OBSIDIAN_MOC_PATH=

# Optional providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=
EMBEDDING_MODEL=

# Optional application services and observability
DATABASE_URL=
REDIS_URL=
VECTOR_DATABASE_URL=
STORAGE_BUCKET=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional runtime metadata
APP_NAME=study-system
APP_ENV=development
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info
DEBUG=false
DRY_RUN=false
AUTO_CONFIRM=false
