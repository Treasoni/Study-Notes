# === DeepSeek ===
# 必填。https://platform.deepseek.com 创建 API Key
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用，必须用 V4 名称
DEEPSEEK_MODEL=deepseek-v4-flash
# disabled | enabled
# V4 思考模式默认开启；关闭后避免工具轮次 reasoning_content 回传 400，且允许 temperature。
# 关闭思考 = 更快、更便宜、单轮控制更稳。
DEEPSEEK_THINKING=disabled

# === Home Assistant ===
# host 网络下容器内用 127.0.0.1 即可直连 HA；跨主机改成 HA 的 IP
HA_BASE_URL=http://127.0.0.1:8123
# 必填。HA 个人资料页创建 Long-Lived Access Token（最长 10 年）
HA_TOKEN=your-long-lived-access-token
HA_TIMEOUT=10
