.DS_Store

# Security - never commit secrets
.env
.env.local
.env.*.local

# API keys and tokens
*.key
*.pem
*.p12
.claudian/
.claude/claudian-settings.json
.claude/sessions/
.claude/settings.local.json
.obsidian/plugins/i18n/main.js

# Logs that may contain sensitive data
*.log
logs/

# Temporary files
*.tmp
*.temp
.tmp/
__pycache__/
*.pyc

# Security audit logs (local only)
**/security-audit.log
**/security-incident.md

# LLM usage telemetry (local only, may drift from schema)
.llm/prompt-cache/*.jsonl
.llm/prompt-cache/.collect-state.json

# Obsidian local UI state (device-specific; causes conflicts on every pull)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
