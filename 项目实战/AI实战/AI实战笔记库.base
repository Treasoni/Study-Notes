---
filters:
  and:
    - file.inFolder("项目实战/AI实战")
    - 'file.ext == "md"'

formulas:
  has_wikilinks: 'if(file.links.length > 0, "是", "否")'
  days_since_created: '(now() - file.ctime).days.round(0)'

properties:
  type:
    displayName: "笔记类型"
  difficulty:
    displayName: "难度"

views:
  - type: table
    name: "AI 实战笔记总览"
    order:
      - file.name
      - type
      - difficulty
      - file.tags
      - file.ctime
      - formula.days_since_created
      - formula.has_wikilinks
    groupBy:
      property: type
      direction: ASC
    summaries:
      file.name: Count

  - type: cards
    name: "卡片视图"
    limit: 20
    order:
      - file.name
      - type
      - difficulty
      - file.tags
---
